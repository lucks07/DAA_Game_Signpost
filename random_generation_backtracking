class App:
    def __init__(self, root):
        self.root = root
        self.root.title("Signpost - Puzzle")
        self.root.configure(bg='#0D1117')
        self.splash = SplashScreen(root, self.on_splash_done)

    def on_splash_done(self):
        DifficultyScreen(self.root, self.on_difficulty_chosen)

    def on_difficulty_chosen(self, mistake_pct: int):
        for widget in self.root.winfo_children():
            widget.destroy()
        self.root.configure(bg='#1C1F26')
        PuzzleGameGUI(self.root, mistake_pct=mistake_pct)


if __name__ == "__main__":
    root = tk.Tk()
    root.geometry("1100x700")
    root.minsize(1000, 620)
    App(root)
    root.mainloop()
