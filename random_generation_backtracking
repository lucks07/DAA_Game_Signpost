# CPU PLAYER
# ====================

class BacktrackingCPU:
    """
    THE BUG THAT CAUSED 'CPU has no legal moves' FOREVER:
      backtrack() mutated visited_set in-place and when it found a path it
      returned immediately without removing the nodes it had added.
      So after backtrack() returned, visited_set contained ALL nodes →
      legal_moves was always empty → get_best_move returned None every time.

    THE FIX:
      Pass a copy of visited_set into backtrack() so the caller's set is
      never touched. Then mistakes are implemented cleanly: if the current
      node has >1 legal neighbour we occasionally pick a wrong one.
    """
    MISTAKE_CHANCE = 0.55   # 55 % chance CPU picks a wrong neighbour (when one exists)

    def __init__(self, graph, game_state):
        self.graph      = graph
        self.game_state = game_state
        self.goal_label = 'P'
        self.all_labels = set(self.graph.nodes.keys())

    def backtrack(self, cur, visited_copy, path):
        """Runs on a COPY of visited_set — never mutates the caller's set."""
        if cur == self.goal_label and len(visited_copy) == len(self.all_labels):
            return list(path)
        for nxt in self.graph.get_neighbors(cur):
            if nxt in visited_copy:
                continue
            visited_copy.add(nxt)
            path.append(nxt)
            result = self.backtrack(nxt, visited_copy, path)
            if result is not None:
                return result
            path.pop()
            visited_copy.remove(nxt)
        return None

    def get_best_move(self):
        cur         = self.game_state.current_position
        # Original visited set — never passed directly into backtrack
        visited_set = {lbl for lbl, node in self.graph.nodes.items() if node.visited}

        # Legal neighbours = arrow-reachable AND not yet visited
        legal = [n for n in self.graph.get_neighbors(cur) if n not in visited_set]

        if not legal:
            return None     # genuine dead-end (shouldn't happen in a valid puzzle)

        # Find the correct move — pass a COPY so visited_set stays clean
        correct = None
        result  = self.backtrack(cur, visited_set | {cur}, [cur])
        if result and len(result) > 1:
            correct = result[1]

        # Wrong options = legal neighbours that are NOT the correct move
        wrong = [n for n in legal if n != correct]

        # Only blunder when a genuinely wrong option exists
        # (no fake errors on forced single-neighbour moves)
        if wrong and correct and random.random() < self.MISTAKE_CHANCE:
            return random.choice(wrong)     # deliberate wrong pick → counted as error

        return correct if correct else random.choice(legal)


