class DifficultyScreen:
    C = {
        'bg': '#0D1117', 'surface': '#161B22', 'gold': '#F0C040',
        'amber': '#E8A838', 'text': '#EAEDF3', 'text2': '#8A90A0',
        'border': '#30363D', 'green': '#4CAF82', 'red': '#E05C5C',
        'blue': '#5B9CF6',
    }

    def __init__(self, root, on_difficulty_chosen):
        self.root = root
        self.on_chosen = on_difficulty_chosen
        self.sfx = SoundManager()
        self.selected = tk.StringVar(value='')
        self._pending_pct = None
        self._diff_btns = {}
        self._resize_id = None
        self._quote = random.choice(FUNNY_QUOTES)

        self.frame = tk.Frame(root, bg=self.C['bg'])
        self.frame.pack(fill='both', expand=True)

        self.canvas = tk.Canvas(self.frame, bg=self.C['bg'], highlightthickness=0)
        self.canvas.pack(fill='both', expand=True)
        self.canvas.bind('<Configure>', self._on_resize)

    def _on_resize(self, event):
        if self._resize_id:
            self.root.after_cancel(self._resize_id)
        self._resize_id = self.root.after(60, self._build)

    def _build(self):
        c = self.canvas
        c.delete('all')
        # destroy old widgets
        for w in self._diff_btns.values():
            for k in ('frame', 'lbl', 'pct', 'outer'):
                try: w[k].destroy()
                except: pass
        self._diff_btns = {}

        W = c.winfo_width()
        H = c.winfo_height()
        if W < 10 or H < 10:
            return

        # ── scale factor based on window size ──────────────────
        scale = min(W / 1100, H / 700)
        fs = lambda n: max(8, int(n * scale))  # font scaler

        # ── title ──────────────────────────────────────────────
        ty = H * 0.07
        c.create_text(W/2, ty, text='SIGNPOST',
                      font=('Georgia', fs(38), 'bold'),
                      fill=self.C['gold'])
        c.create_text(W/2, ty + fs(46),
                      text='Choose Your Doom  —  or a Reasonable Challenge',
                      font=('Courier', fs(13), 'italic'),
                      fill=self.C['text2'])

        # ── quote box ──────────────────────────────────────────
        qy = ty + fs(80)
        qw = W * 0.72
        qh = fs(68)
        qx0, qx1 = W/2 - qw/2, W/2 + qw/2
        c.create_rectangle(qx0, qy, qx1, qy+qh,
                           fill=self.C['surface'], outline=self.C['amber'], width=2)
        c.create_text(W/2, qy + qh/2, text=self._quote,
                      font=('Courier', fs(11), 'italic'),
                      fill=self.C['amber'], width=qw - fs(40), justify='center')

        # ── legend ─────────────────────────────────────────────
        ly = qy + qh + fs(24)
        c.create_text(W/2, ly,
                      text='CPU Blunder %  —  higher % means CPU messes up MORE (easier for you!)',
                      font=('Courier', fs(11)), fill=self.C['text2'])

        # ── difficulty cards ───────────────────────────────────
        diffs = [
            ('easy',   '😴  EASY',   self.C['green'],
             'CPU blunders: ~60–85%\n"The CPU forgot what arrows are."\nPerfect for warm-ups.'),
            ('medium', '😤  MEDIUM', self.C['amber'],
             'CPU blunders: ~35–60%\n"The CPU read half the manual."\nA fair fight. Mostly.'),
            ('hard',   '💀  HARD',   self.C['red'],
             'CPU blunders: ~10–30%\n"The CPU memorised every path."\nGood luck. You\'ll need it.'),
        ]

        card_w = int(W * 0.22)
        card_h = int(H * 0.16)
        card_gap = int(W * 0.04)
        total_w = 3 * card_w + 2 * card_gap
        card_y = ly + fs(36)
        card_x_start = W/2 - total_w/2

        for i, (key, lbl, color, desc_text) in enumerate(diffs):
            cx = card_x_start + i * (card_w + card_gap)
            cy = card_y

            outer = tk.Frame(self.frame, bg=self.C['border'], padx=2, pady=2)
            btn_frame = tk.Frame(outer, bg=self.C['surface'], cursor='hand2',
                                 width=card_w, height=card_h)
            btn_frame.pack()
            btn_frame.pack_propagate(False)

            lbl_widget = tk.Label(btn_frame, text=lbl,
                                  font=('Courier', fs(16), 'bold'),
                                  fg=color, bg=self.C['surface'], cursor='hand2')
            lbl_widget.place(relx=0.5, rely=0.38, anchor='center')

            lo, hi = DIFFICULTY_RANGES[key]
            pct_widget = tk.Label(btn_frame,
                                  text=f'blunder rate  {lo}–{hi}%',
                                  font=('Courier', fs(10)),
                                  fg=self.C['text2'], bg=self.C['surface'], cursor='hand2')
            pct_widget.place(relx=0.5, rely=0.72, anchor='center')

            c.create_window(cx, cy, window=outer, anchor='nw')

            # desc text below card
            c.create_text(cx + card_w/2, cy + card_h + fs(36),
                          text=desc_text, font=('Courier', fs(9)),
                          fill=self.C['text2'], justify='center',
                          width=card_w + 10)

            self._diff_btns[key] = {
                'outer': outer, 'frame': btn_frame,
                'lbl': lbl_widget, 'pct': pct_widget,
                'color': color, 'cx': cx, 'cy': cy,
                'card_w': card_w, 'card_h': card_h,
            }

            for widget in (btn_frame, lbl_widget, pct_widget):
                widget.bind('<Enter>', lambda e, k=key: self._hover(k, True))
                widget.bind('<Leave>', lambda e, k=key: self._hover(k, False))
                widget.bind('<Button-1>', lambda e, k=key: self._select(k))

        # ── custom % row ───────────────────────────────────────
        custom_y = card_y + card_h + fs(100)
        c.create_text(W/2, custom_y,
                      text='Or enter a custom blunder %  (0 = genius CPU,  100 = blind CPU):',
                      font=('Courier', fs(11)), fill=self.C['text2'])

        input_frame = tk.Frame(self.frame, bg=self.C['bg'])
        self.custom_entry = tk.Entry(input_frame, width=5,
                                     font=('Courier', fs(13), 'bold'),
                                     bg=self.C['surface'], fg=self.C['gold'],
                                     insertbackground=self.C['gold'],
                                     relief='flat', bd=0,
                                     highlightbackground=self.C['border'],
                                     highlightthickness=1, justify='center')
        self.custom_entry.pack(side='left', padx=(0, 8))

        tk.Button(input_frame, text='USE THIS %',
                  font=('Courier', fs(11), 'bold'),
                  bg=self.C['surface'], fg=self.C['blue'],
                  activebackground=self.C['border'], activeforeground=self.C['text'],
                  relief='flat', bd=0, padx=12, pady=4, cursor='hand2',
                  command=self._use_custom).pack(side='left')

        self.custom_err = tk.Label(input_frame, text='', font=('Courier', fs(10)),
                                   fg=self.C['red'], bg=self.C['bg'])
        self.custom_err.pack(side='left', padx=8)
        c.create_window(W/2, custom_y + fs(36), window=input_frame, anchor='center')

        # ── lock in button ─────────────────────────────────────
        btn_y = custom_y + fs(84)
        self.confirm_btn = tk.Button(
            self.frame, text='LOCK IN & PLAY  ▶',
            font=('Courier', fs(15), 'bold'),
            bg='#1A3A1A', fg=self.C['green'],
            activebackground='#2A5A2A', activeforeground='#6FE0A0',
            relief='flat', bd=0, padx=int(36*scale), pady=int(14*scale),
            cursor='hand2', state='disabled', command=self._confirm)
        c.create_window(W/2, btn_y, window=self.confirm_btn, anchor='center')

        self._pending_pct = self._pending_pct  # preserve across redraws

    def _hover(self, key, entering):
        w = self._diff_btns.get(key)
        if not w:
            return
        if entering:
            theme = CARD_HOVER_THEME[key]
            w['frame'].config(bg=theme['bg'])
            w['lbl'].config(bg=theme['bg'])
            w['pct'].config(bg=theme['bg'])
            w['outer'].config(bg=theme['border'])
        else:
            is_sel = (self.selected.get() == key)
            bg = self._darken(w['color'], 0.30) if is_sel else self.C['surface']
            border = w['color'] if is_sel else self.C['border']
            w['frame'].config(bg=bg)
            w['lbl'].config(bg=bg)
            w['pct'].config(bg=bg)
            w['outer'].config(bg=border)

    def _select(self, key):
        self.sfx.play("tick")
        self.selected.set(key)
        for k, w in self._diff_btns.items():
            if k == key:
                bg = self._darken(w['color'], 0.30)
                w['frame'].config(bg=bg)
                w['lbl'].config(bg=bg)
                w['pct'].config(bg=bg)
                w['outer'].config(bg=w['color'])
            else:
                w['frame'].config(bg=self.C['surface'])
                w['lbl'].config(bg=self.C['surface'])
                w['pct'].config(bg=self.C['surface'])
                w['outer'].config(bg=self.C['border'])

        lo, hi = DIFFICULTY_RANGES[key]
        self._pending_pct = random.randint(lo, hi)
        try:
            self.confirm_btn.config(state='normal')
            self.custom_err.config(text='')
            self.custom_entry.delete(0, tk.END)
        except Exception:
            pass

    def _use_custom(self):
        try:
            val = self.custom_entry.get().strip()
        except Exception:
            return
        try:
            pct = int(val)
            if not (0 <= pct <= 100):
                raise ValueError
            self.sfx.play("tick")
            self._pending_pct = pct
            self.selected.set('custom')
            for w in self._diff_btns.values():
                w['frame'].config(bg=self.C['surface'])
                w['lbl'].config(bg=self.C['surface'])
                w['pct'].config(bg=self.C['surface'])
                w['outer'].config(bg=self.C['border'])
            self.custom_err.config(text=f'✓  Set to {pct}%', fg=self.C['green'])
            self.confirm_btn.config(state='normal')
        except ValueError:
            try:
                self.custom_err.config(text='Enter a whole number 0–100', fg=self.C['red'])
            except Exception:
                pass

    def _confirm(self):
        if self._pending_pct is None:
            return
        self.sfx.play("reset")
        pct = self._pending_pct
        self.frame.destroy()
        self.on_chosen(pct)

    def _darken(self, hex_col, factor=0.4):
        hex_col = hex_col.lstrip('#')
        r, g, b = int(hex_col[0:2],16), int(hex_col[2:4],16), int(hex_col[4:6],16)
        return '#{:02x}{:02x}{:02x}'.format(max(0,int(r*factor)),
                                             max(0,int(g*factor)),
                                             max(0,int(b*factor)))


