def _make_sound(samples: list, volume: float = 0.6):
    if not SOUND_AVAILABLE:
        return None
    peak = volume * 32767
    raw = _array.array('h', [max(-32768, min(32767, int(s * peak))) for s in samples])
    return pygame.mixer.Sound(buffer=raw.tobytes())


def _env(i: int, n: int, a_n: int, d_n: int) -> float:
    if i < a_n:
        return i / a_n if a_n else 1.0
    elif i >= n - d_n:
        return max(0.0, (n - 1 - i) / d_n) if d_n else 1.0
    return 1.0


def _sine_samples(freq, duration, sr=44100, attack=0.01, decay=0.05):
    n = int(sr * duration)
    a_n, d_n = int(attack * sr), int(decay * sr)
    return [math.sin(2 * math.pi * freq * i / sr) * _env(i, n, a_n, d_n) for i in range(n)]


def _square_samples(freq, duration, sr=44100, attack=0.005, decay=0.04, duty=0.5, harmonics=8):
    n = int(sr * duration)
    a_n, d_n = int(attack * sr), int(decay * sr)
    out = []
    for i in range(n):
        t = i / sr
        val = sum(math.sin(2 * math.pi * k * freq * t - math.pi * duty * k) / k
                  for k in range(1, harmonics * 2, 2))
        val *= (4 / math.pi)
        out.append(val * _env(i, n, a_n, d_n))
    return out


def _triangle_samples(freq, duration, sr=44100, attack=0.005, decay=0.06):
    n = int(sr * duration)
    a_n, d_n = int(attack * sr), int(decay * sr)
    period = sr / freq
    out = []
    for i in range(n):
        phase = (i % period) / period
        val = 4 * abs(phase - 0.5) - 1.0
        out.append(val * _env(i, n, a_n, d_n))
    return out


def _silence(duration, sr=44100):
    return [0.0] * int(sr * duration)


def _concat(*parts):
    result = []
    for p in parts:
        result.extend(p)
    return result


