    def _draw_start_button(self, c, cx, cy, w, h):
        
        x0, y0 = cx-w/2, cy-h/2
        x1, y1 = cx+w/2, cy+h/2
        for i in range(4, 0, -1):
            alpha_col = ['#1A4A1A','#1F5A1F','#246024','#2A702A'][i-1]
            c.create_rectangle(x0-i, y0-i, x1+i, y1+i, fill='', outline=alpha_col, width=1)
        rect = c.create_rectangle(x0, y0, x1, y1, fill='#1A3A1A',
                                  outline=self.C['green'], width=2)
        text = c.create_text(cx, cy, text='▶ START GAME',
                             fill=self.C['green'], font=('Courier', 16, 'bold'))

        def on_enter(e):
            c.itemconfig(rect, fill='#2A5A2A', outline='#6FE0A0')
            c.itemconfig(text, fill='#6FE0A0')

        def on_leave(e):
            c.itemconfig(rect, fill='#1A3A1A', outline=self.C['green'])
            c.itemconfig(text, fill=self.C['green'])

        def on_click(e):
            self.sfx.play("reset")
            self.destroy()
            self.on_start()

        for tag_id in (rect, text):
            c.tag_bind(tag_id, '<Enter>', on_enter)
            c.tag_bind(tag_id, '<Leave>', on_leave)
            c.tag_bind(tag_id, '<Button-1>', on_click)

    def destroy(self):
        self.frame.destroy()


