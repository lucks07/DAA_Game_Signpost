class GraphNode:
    def __init__(self, label, row, col, arrow_direction):
        self.label = label
        self.row = row
        self.col = col
        self.arrow_direction = arrow_direction
        self.visited = False
        self.visit_order = None


class PuzzleGraph:
    def __init__(self):
        self.nodes = {}
        self.adjacency_list = {}
        self.solution_path = []

    def add_node(self, label, row, col, arrow_direction):
        self.nodes[label] = GraphNode(label, row, col, arrow_direction)
        self.adjacency_list[label] = []

    def add_edge(self, from_label, to_label):
        if from_label in self.adjacency_list:
            if to_label not in self.adjacency_list[from_label]:
                self.adjacency_list[from_label].append(to_label)

    def get_neighbors(self, label):
        return self.adjacency_list.get(label, [])

    def set_solution_path(self, path):
        self.solution_path = path


def build_label_grid():
    label_to_pos = {}
    pos_to_label = {}
    for r in range(ROWS):
        for c in range(COLS):
            lbl = GRID_LABELS[r][c]
            label_to_pos[lbl] = (r, c)
            pos_to_label[(r, c)] = lbl
    return label_to_pos, pos_to_label


def all_nodes_in_direction(row, col, dr, dc, pos_to_label):
    results = []
    r, c = row + dr, col + dc
    while 0 <= r < ROWS and 0 <= c < COLS:
        results.append(pos_to_label[(r, c)])
        r += dr
        c += dc
    return results


def random_hamiltonian_path_king(label_to_pos, pos_to_label, start='A', goal='P'):
    all_labels = set(label_to_pos.keys())
    visited = {start}
    path = [start]

    def neighbors_king(lbl):
        r, c = label_to_pos[lbl]
        nbrs = []
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                rr, cc = r + dr, c + dc
                while (rr, cc) in pos_to_label:
                    nbrs.append(pos_to_label[(rr, cc)])
                    rr += dr
                    cc += dc
        random.shuffle(nbrs)
        return nbrs
    
    def backtrack(cur):
        if visited == all_labels and cur == goal:
            return True
        for nxt in neighbors_king(cur):
            if nxt in visited:
                continue
            visited.add(nxt)
            path.append(nxt)
            if backtrack(nxt):
                return True
            path.pop()
            visited.remove(nxt)
        return False

    if backtrack(start):
        return path
    return None


def generate_signpost_puzzle():
    label_to_pos, pos_to_label = build_label_grid()
    path = None
    for _ in range(200):
        path = random_hamiltonian_path_king(label_to_pos, pos_to_label)
        if path is not None:
            break
    if path is None:
        raise RuntimeError("Could not find Hamiltonian path after many tries.")

    graph = PuzzleGraph()
    for lbl, (r, c) in label_to_pos.items():
        graph.add_node(lbl, r, c, '•')

    for i, lbl in enumerate(path[:-1]):
        next_lbl = path[i + 1]
        r, c = label_to_pos[lbl]
        nr, nc = label_to_pos[next_lbl]
        dr = 0 if nr == r else (1 if nr > r else -1)
        dc = 0 if nc == c else (1 if nc > c else -1)
        arrow = DIR_TO_ARROW.get((dr, dc), '•')
        graph.nodes[lbl].arrow_direction = arrow
        ray_targets = all_nodes_in_direction(r, c, dr, dc, pos_to_label)
        for t in ray_targets:
            graph.add_edge(lbl, t)

    graph.nodes['P'].arrow_direction = '★'
    graph.set_solution_path(path)
    return graph


class GameState:
    def __init__(self, graph):
        self.graph = graph
        self.current_position = 'A'
        self.current_turn = 'Human'
        self.visit_count = 1
        self.human_correct_moves = 0
        self.human_illegal_moves = 0
        self.cpu_correct_moves = 0
        self.cpu_illegal_moves = 0
        self.cpu_illegal_history = set()
        self.graph.nodes['A'].visited = True
        self.graph.nodes['A'].visit_order = 1
        self.game_over = False
        self.winner = None

    def is_legal_move(self, target):
        if target not in self.graph.get_neighbors(self.current_position):
            return False
        if target not in self.graph.nodes:
            return False
        if self.graph.nodes[target].visited:
            return False
        return True

    def is_correct_move(self, target):
        try:
            idx = self.graph.solution_path.index(self.current_position)
            return self.graph.solution_path[idx + 1] == target
        except (ValueError, IndexError):
            return False

    def make_move(self, target):
        if self.game_over:
            return False, False
        if target is None or target not in self.graph.nodes:
            legal = correct = False
        else:
            legal = self.is_legal_move(target)
            correct = self.is_correct_move(target)

        if not legal or not correct:
            if self.current_turn == 'Human':
                self.human_illegal_moves += 1
            else:
                self.cpu_illegal_moves += 1
                self.cpu_illegal_history.add((self.current_position, target))
            self.switch_turn()
            return False, False

        self.visit_count += 1
        node = self.graph.nodes[target]
        node.visited = True
        node.visit_order = self.visit_count
        self.current_position = target

        if self.current_turn == 'Human':
            self.human_correct_moves += 1
        else:
            self.cpu_correct_moves += 1

        if target == 'P':
            self.game_over = True
            self.determine_winner()

        self.switch_turn()
        return True, True

    def switch_turn(self):
        self.current_turn = 'CPU' if self.current_turn == 'Human' else 'Human'

    def determine_winner(self):
        if self.human_illegal_moves < self.cpu_illegal_moves:
            self.winner = 'Human'
        elif self.cpu_illegal_moves < self.human_illegal_moves:
            self.winner = 'CPU'
        else:
            self.winner = 'Draw'


class BacktrackingCPU:
    def __init__(self, graph, game_state, mistake_chance: float = 0.55):
        self.graph = graph
        self.game_state = game_state
        self.goal_label = 'P'
        self.all_labels = set(self.graph.nodes.keys())
        self.mistake_chance = mistake_chance

    def backtrack(self, cur, visited_copy, path):
        if cur == self.goal_label and len(visited_copy) == len(self.all_labels):
            return list(path)
        for nxt in self.graph.get_neighbors(cur):
            if nxt in visited_copy:
                continue
            visited_copy.add(nxt)
            path.append(nxt)
            result = self.backtrack(nxt, visited_copy, path)
            if result is not None:
                return result
            path.pop()
            visited_copy.remove(nxt)
        return None

    def get_best_move(self):
        cur = self.game_state.current_position
        visited_set = {lbl for lbl, node in self.graph.nodes.items() if node.visited}
        legal = [n for n in self.graph.get_neighbors(cur) if n not in visited_set]

        if not legal:
            return None

        correct = None
        result = self.backtrack(cur, visited_set | {cur}, [cur])
        if result and len(result) > 1:
            correct = result[1]

        wrong = [n for n in legal if n != correct]

        if wrong and correct and random.random() < self.mistake_chance:
            return random.choice(wrong)

        return correct if correct else random.choice(legal)


