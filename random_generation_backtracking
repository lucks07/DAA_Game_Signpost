def _make_sound(samples: list, volume: float = 0.6):
    if not SOUND_AVAILABLE:
        return None

    peak = volume * 32767
    raw = _array.array('h', [max(-32768, min(32767, int(s * peak))) for s in samples])

    sound = pygame.mixer.Sound(buffer=raw)

    return sound


def _env(i: int, n: int, a_n: int, d_n: int) -> float:
    if i < a_n:
        return i / a_n if a_n else 1.0
    elif i >= n - d_n:
        return max(0.0, (n - 1 - i) / d_n) if d_n else 1.0
    return 1.0


def _sine_samples(freq: float, duration: float, sr: int = 44100,
                  attack: float = 0.01, decay: float = 0.05) -> list:
    n = int(sr * duration)
    a_n, d_n = int(attack * sr), int(decay * sr)
    return [math.sin(2 * math.pi * freq * i / sr) * _env(i, n, a_n, d_n)
            for i in range(n)]


def _square_samples(freq: float, duration: float, sr: int = 44100,
                    attack: float = 0.005, decay: float = 0.04,
                    duty: float = 0.5, harmonics: int = 8) -> list:

    n = int(sr * duration)
    a_n, d_n = int(attack * sr), int(decay * sr)
    out = []
    for i in range(n):
        t = i / sr
        val = 0.0
        for k in range(1, harmonics * 2, 2):          # odd harmonics only
            val += math.sin(2 * math.pi * k * freq * t - math.pi * duty * k) / k
        val *= (4 / math.pi)                           # normalise
        out.append(val * _env(i, n, a_n, d_n))
    return out


def _triangle_samples(freq: float, duration: float, sr: int = 44100,
                      attack: float = 0.005, decay: float = 0.06) -> list:
    """Triangle wave — warmer than square, punchier than sine. Great for bass notes."""
    n = int(sr * duration)
    a_n, d_n = int(attack * sr), int(decay * sr)
    out = []
    period = sr / freq
    for i in range(n):
        phase = (i % period) / period          # 0..1
        val = 4 * abs(phase - 0.5) - 1.0      # triangle shape
        out.append(val * _env(i, n, a_n, d_n))
    return out


def _silence(duration: float, sr: int = 44100) -> list:
    return [0.0] * int(sr * duration)


def _concat(*parts) -> list:
    result = []
    for p in parts:
        result.extend(p)
    return result


